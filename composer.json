{
    "name": "jeavenguitar/web3php",
    "description": "PHP Ethereum/EVM toolkit in web3.js style: robust JSON-RPC client (multi-endpoint failover, retry, keep-alive), full ABI encoder/decoder (tuple/array/named outputs), contract calls and locally signed transactions (EIP-155 / EIP-1559).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ethereum",
        "evm",
        "web3",
        "bsc",
        "arbitrum",
        "polygon",
        "rpc",
        "abi",
        "smart-contract",
        "solidity"
    ],
    "authors": [
        {
            "name": "jeavenguitar"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-gmp": "*",
        "ext-json": "*",
        "kornrunner/keccak": "^1.1",
        "simplito/elliptic-php": "^1.0.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Web3php\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Web3php\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
